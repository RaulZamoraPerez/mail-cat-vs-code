{
  "name": "rzp-mail-sandbox",
  "displayName": "MailCat - Local SMTP Sandbox",
  "description": "A powerful local SMTP server and email testing sandbox for developers. Catch, preview, and validate emails without sending them.",
  "version": "0.1.0",
  "publisher": "RaulZ",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "activationEvents": [
    "onCommand:rzp-mail-sandbox.start"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rzp-mail-sandbox.start",
        "title": "RZP Mail: Start Sandbox",
        "category": "RZP Mail"
      },
      {
        "command": "rzp-mail-sandbox.stop",
        "title": "RZP Mail: Stop Sandbox",
        "category": "RZP Mail"
      },
      {
        "command": "rzp-mail-sandbox.openInbox",
        "title": "RZP Mail: Open Inbox in Tab",
        "category": "RZP Mail"
      },
      {
        "command": "rzp-mail-sandbox.copyConfig",
        "title": "RZP Mail: Copy SMTP Config",
        "category": "RZP Mail"
      },
      {
        "command": "rzp-mail-sandbox.clearInbox",
        "title": "RZP Mail: Clear Inbox",
        "category": "RZP Mail"
      },
      {
        "command": "rzp-mail-sandbox.debug-storage",
        "title": "RZP Mail: Debug Storage (Ver emails en memoria)",
        "category": "RZP Mail"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rzp-mail-view",
          "title": "RZP Mail",
          "icon": "media/mail-icon.svg"
        }
      ]
    },
    "views": {
      "rzp-mail-view": [
        {
          "id": "rzp-mail-status",
          "name": "Status",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^4.26.1",
    "@typescript-eslint/parser": "^4.26.1",
    "typescript": "^4.3.2",
    "eslint": "^7.28.0",
    "@vscode/test-electron": "^1.6.2"
  },
  "dependencies": {
    "smtp-server": "^3.11.0",
    "mailparser": "^3.5.0"
  }
}
