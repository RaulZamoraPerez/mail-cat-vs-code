{
  "name": "mailcat",
  "displayName": "MailCat",
  "description": "Local SMTP sandbox directly inside VS Code. Catch, preview, and validate emails without sending them.",
  "version": "1.0.0",
  "publisher": "raulzamora",
  "icon": "images/logo.png",
  
  "engines": {
    "vscode": "^1.60.0"
  },

  "categories": [
    "Other",
    "Debuggers",
    "Testing"
  ],

  "keywords": [
    "smtp",
    "email",
    "mail",
    "sandbox",
    "testing",
    "nodemailer",
    "developer-tools",
    "local-testing",
    "debugging"
  ],

  "repository": {
    "type": "git",
    "url": "https://github.com/RaulZ/email-extension-vscode"
  },

  "homepage": "https://github.com/RaulZ/email-extension-vscode",

  "bugs": {
    "url": "https://github.com/RaulZ/email-extension-vscode/issues"
  },

  "license": "MIT",

  "activationEvents": [
    "onCommand:rzp-mail-sandbox.start"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rzp-mail-sandbox.start",
        "title": "MailCat: Start Sandbox",
        "category": "MailCat"
      },
      {
        "command": "rzp-mail-sandbox.stop",
        "title": "MailCat: Stop Sandbox",
        "category": "MailCat"
      },
      {
        "command": "rzp-mail-sandbox.openInbox",
        "title": "MailCat: Open Inbox in Tab",
        "category": "MailCat"
      },
      {
        "command": "rzp-mail-sandbox.copyConfig",
        "title": "MailCat: Copy SMTP Config",
        "category": "MailCat"
      },
      {
        "command": "rzp-mail-sandbox.clearInbox",
        "title": "MailCat: Clear Inbox",
        "category": "MailCat"
      },
      {
        "command": "rzp-mail-sandbox.debug-storage",
        "title": "MailCat: Debug Storage (Ver emails en memoria)",
        "category": "MailCat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rzp-mail-view",
          "title": "MailCat",
          "icon": "media/mail-icon.svg"
        }
      ]
    },
    "views": {
      "rzp-mail-view": [
        {
          "id": "rzp-mail-status",
          "name": "Status",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^4.26.1",
    "@typescript-eslint/parser": "^4.26.1",
    "@vscode/test-electron": "^1.6.2",
    "eslint": "^7.28.0",
    "typescript": "^4.3.2"
  },
  "dependencies": {
    "mailparser": "^3.5.0",
    "smtp-server": "^3.11.0"
  }
}
